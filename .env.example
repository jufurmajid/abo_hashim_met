# Provider Selection Configurations
# Database options: 'mock' | 'd1' | 'postgres' | 'supabase'
DB_PROVIDER=mock

# Storage options: 'mock' | 'r2' | 's3'
STORAGE_PROVIDER=mock

# Cloudflare D1 Database Binding Name (for D1 provider)
DB_BINDING=DB

# Cloudflare R2 Storage Credentials (for R2 provider)
R2_BUCKET_NAME=abo-hashim-media
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key

# PostgreSQL / Supabase Database Connection String (for PostgreSQL/Supabase provider)
DATABASE_URL=postgresql://user:password@localhost:5432/abohashim_db

# Telegram Admin Bot Credentials
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Telegram Orders Bot Credentials
TELEGRAM_ORDERS_BOT_TOKEN=your_orders_bot_token_here
TELEGRAM_ORDERS_CHAT_ID=your_orders_chat_id_here
